<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Amazon.com</title>
</head>
<body>
<form action="http://localhost:8080/customers" method = "POST">
	<label for="message"> Name: </label><br>
	<input type="text" id="name" name="name"><br>
	<label for="message"> Email: </label><br>
	<input type="email" id="email" name="email"><br>
	<label for="message"> Phone No.: </label><br>
	<input type="number" id="phoneNumber" name="phoneNumber"><br>
	<button type="submit">Submit</button>
</form>

<form action="/orders" method = "POST">
	<label for="message">Product:</label><br>
	<input type="text" id="product" name="product"><br>
	<label for="message">Quantity:</label><br>
	<input type="number" id="quantity" name="quantity"><br>
	<label for="message">Order Date:</label><br>
	<input type="date" id="orderDate" name="orderDate"><br>
	<button type = "submit">Submit</button>
</form>
</body>
</html>